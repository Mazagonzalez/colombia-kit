{
  "name": "@colombia-kit/divipola",
  "version": "0.0.0",
  "description": "Departamentos y municipios de Colombia con los códigos DIVIPOLA del DANE.",
  "keywords": [
    "colombia",
    "divipola",
    "dane",
    "municipios",
    "departamentos"
  ],
  "license": "MIT AND CC-BY-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mazagonzalez/colombia-kit.git",
    "directory": "packages/divipola"
  },
  "homepage": "https://github.com/Mazagonzalez/colombia-kit/tree/main/packages/divipola#readme",
  "bugs": "https://github.com/Mazagonzalez/colombia-kit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./departamentos": {
      "import": {
        "types": "./dist/departamentos.d.ts",
        "default": "./dist/departamentos.js"
      },
      "require": {
        "types": "./dist/departamentos.d.cts",
        "default": "./dist/departamentos.cjs"
      }
    },
    "./municipios": {
      "import": {
        "types": "./dist/municipios.d.ts",
        "default": "./dist/municipios.js"
      },
      "require": {
        "types": "./dist/municipios.d.cts",
        "default": "./dist/municipios.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:paquete": "publint && attw --pack . --profile node16 && node ../../scripts/verificar-entradas-divipola.mjs"
  }
}
