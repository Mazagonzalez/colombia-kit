{
  "name": "@colombia-kit/direcciones",
  "version": "0.1.0",
  "description": "Parsea, normaliza y formatea direcciones colombianas.",
  "keywords": [
    "colombia",
    "direcciones",
    "parser",
    "nomenclatura"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mazagonzalez/colombia-kit.git",
    "directory": "packages/direcciones"
  },
  "homepage": "https://github.com/Mazagonzalez/colombia-kit/tree/main/packages/direcciones#readme",
  "bugs": "https://github.com/Mazagonzalez/colombia-kit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:paquete": "publint && attw --pack . --profile node16"
  }
}
